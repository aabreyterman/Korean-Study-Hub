      "corrections": [
        "인지 → -(으)ㄴ 지 for elapsed time since an action.",
        "돈으로 (with money) → 동료 for coworker.",
        "한잔 (a drink) → 한참 for a long time.",
        "교회 (church) → 교외 for suburb.",
        "출신 means origin / being from; 고향 is hometown."
      ],
      "entries": [
        {
          "key": "since",
          "kind": "grammar",
          "korean": "-(으)ㄴ 지",
          "meaning": "it has been [length of time] since …",
          "pronunciation": "은 지",
          "note": "Attach -(으)ㄴ to a verb stem and write a space before 지. Use a duration + 되다 / 지나다. This is different from -는지 / -인지 (whether / an embedded question). Example: 한국어를 공부한 지 한 달 됐어요. = It has been one month since I started studying Korean."
        },
        {
          "key": "word-1",
          "kind": "vocabulary",
          "korean": "넘게",
          "meaning": "over; more than",
          "note": "After an amount or duration: 한 시간 넘게 = over an hour."
        },
        {
          "key": "word-2",
          "kind": "vocabulary",
          "korean": "동료",
          "meaning": "coworker; colleague",
          "note": "Corrected from dictated 돈으로. 돈으로 means with money / in money."
        },
